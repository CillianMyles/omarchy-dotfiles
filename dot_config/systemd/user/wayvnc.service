[Unit]
Description=VNC server for the Hyprland session
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/wayvnc
# wayvnc exits cleanly when its output disappears (a monitor reconfigure,
# unplug or resume), so on-failure would leave VNC down until the next login.
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target

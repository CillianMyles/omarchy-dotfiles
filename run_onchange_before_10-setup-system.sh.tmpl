#!/bin/bash
# System-level setup that dotfiles can't capture: extra packages, services,
# firewall and locale. Safe to re-run; chezmoi re-runs it whenever this file
# changes. Add a line here whenever you make a system change by hand.
set -euo pipefail

# Re-run when the system config files change:
# {{ include "system/30-headless-lid.conf" | sha256sum }}
# {{ include "system/wake-on-lan.conf" | sha256sum }}
# {{ include "system/hid_apple.conf" | sha256sum }}
# {{ include "system/20-key-only.conf" | sha256sum }}

rebuild_initramfs() {
  if command -v limine-mkinitcpio >/dev/null; then
    sudo limine-mkinitcpio
  fi
}

# Extra packages beyond Omarchy's defaults, plus the ones agents and the fleet
# skills rely on (tmux, jq, sqlite) so they don't depend on Omarchy keeping
# them. `omarchy update` keeps all of them current, then the mise tools.
omarchy pkg add openssh bitwarden bitwarden-cli t3code-bin ethtool tmux jq sqlite

# Keyboard layout system-wide: TTY, boot password prompt, and Hyprland, which
# reads /etc/vconsole.conf. UK unless the machine overrides `keyboard` (see
# .chezmoidata.toml). Hyprland picks up a change at the next login.
{{- $console := replace "gb" "uk" .keyboard }}
if [[ $(localectl status) != *"X11 Layout: {{ .keyboard }}"* ]]; then
  sudo localectl set-keymap {{ $console }}
  sudo localectl set-x11-keymap {{ .keyboard }}
  rebuild_initramfs
fi

# SSH server: keys only (clients in private_dot_ssh/authorized_keys), reachable
# from the home LAN and over Tailscale. The keys are written after this script,
# so run the first apply at the console, not over a password SSH session.
sudo install -m644 "$CHEZMOI_SOURCE_DIR/system/20-key-only.conf" /etc/ssh/sshd_config.d/
sudo systemctl enable --now sshd
sudo systemctl reload sshd
sudo ufw delete allow 22/tcp >/dev/null 2>&1 || true
sudo ufw allow from 192.168.86.0/24 to any port 22 proto tcp comment 'SSH from LAN'
# <box>.local also resolves to the box's IPv6 LAN addresses, which some
# clients (iPhone, iPad) may try first: allow SSH from private IPv6 too.
sudo ufw allow from fc00::/7 to any port 22 proto tcp comment 'SSH from LAN (IPv6)'
sudo ufw allow from fe80::/10 to any port 22 proto tcp comment 'SSH from LAN (IPv6 link-local)'
sudo ufw allow in on tailscale0 to any port 22 proto tcp comment 'SSH over Tailscale'

# mDNS (<box>.local) on wired interfaces only. With wired and Wi-Fi on the same
# LAN, a Wi-Fi roam makes avahi hear its own wired record as a name conflict
# and rename the box <box>-2.local. Wi-Fi-only use still has Tailscale (<box>).
wired=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "ethernet" { printf "%s%s", sep, $1; sep = "," }')
if [[ -n $wired ]] && ! grep -qx "allow-interfaces=$wired" /etc/avahi/avahi-daemon.conf; then
  sudo sed -i -E "s/^#?allow-interfaces=.*/allow-interfaces=$wired/" /etc/avahi/avahi-daemon.conf
  sudo systemctl restart avahi-daemon
fi

# Tailscale. With TS_AUTHKEY set (a reusable key tagged tag:agent, kept in
# Bitwarden) the box joins unattended and never expires; without it, this
# prints a browser login link.
if ! pacman -Q tailscale >/dev/null 2>&1; then
  omarchy pkg add tailscale
fi
sudo systemctl enable --now tailscaled
if ! tailscale status >/dev/null 2>&1; then
  sudo tailscale up --accept-routes ${TS_AUTHKEY:+--auth-key="$TS_AUTHKEY"}
fi
sudo tailscale set --operator="$USER"
systemctl --user enable --now omarchy-tailscale-receive.service || true

# Voxtype dictation.
if ! pacman -Q voxtype-bin >/dev/null 2>&1; then
  omarchy-voxtype-install
fi

# Wake-on-LAN (magic packet) on wired connections, now and for new profiles.
sudo install -m644 "$CHEZMOI_SOURCE_DIR/system/wake-on-lan.conf" /etc/NetworkManager/conf.d/
sudo nmcli general reload conf
nmcli -t -f NAME,TYPE con show | awk -F: '$2 == "802-3-ethernet" { print $1 }' |
  while read -r con; do sudo nmcli con modify "$con" 802-3-ethernet.wake-on-lan magic; done

# Apple keyboards: media keys on the top row, Fn for F1-F12 (Omarchy forces
# the opposite; see omacom/omarchy#7110). Only on Macs.
if [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == Apple* ]] &&
  ! cmp -s "$CHEZMOI_SOURCE_DIR/system/hid_apple.conf" /etc/modprobe.d/hid_apple.conf; then
  sudo install -m644 "$CHEZMOI_SOURCE_DIR/system/hid_apple.conf" /etc/modprobe.d/
  echo 1 | sudo tee /sys/module/hid_apple/parameters/fnmode >/dev/null || true
  rebuild_initramfs
fi

# Headless server: stay awake with the lid closed on AC or with an external
# display (IP KVM) attached; still suspend on battery.
sudo install -m644 "$CHEZMOI_SOURCE_DIR/system/30-headless-lid.conf" /etc/systemd/logind.conf.d/
sudo systemctl reload systemd-logind

# VNC: wayvnc with an encrypted login, only reachable over Tailscale.
omarchy pkg add wayvnc
if [[ ! -f $HOME/.config/wayvnc/rsa_key.pem ]]; then
  mkdir -p "$HOME/.config/wayvnc"
  ssh-keygen -q -m pem -t rsa -b 4096 -N "" -C wayvnc -f "$HOME/.config/wayvnc/rsa_key.pem"
  rm -f "$HOME/.config/wayvnc/rsa_key.pem.pub"
fi
sudo ufw allow in on tailscale0 to any port 5900 proto tcp comment 'VNC over Tailscale'
